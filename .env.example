# Copy this file to .env.local and fill in the values.
# For local development, use the keys printed by `supabase start` / `supabase status`.
# For production (Vercel), set these in the Vercel dashboard — do NOT commit real keys.

# LOCAL: http://127.0.0.1:54321
# PRODUCTION: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# LOCAL: anon key from `supabase status`
# PRODUCTION: publishable key from Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
